
# ARTIFICIAL NEURAL NETWORK USING BACKPROPAGATION
# Dataset: Breast Cancer Classification

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from IPython.display import display
from sklearn.datasets import load_breast_cancer
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.neural_network import MLPClassifier
from sklearn.metrics import (
    accuracy_score, confusion_matrix,
    classification_report, ConfusionMatrixDisplay
)

# 1. Load the dataset
cancer = load_breast_cancer()
X = pd.DataFrame(cancer.data, columns=cancer.feature_names)
y = cancer.target

print("=" * 55)
print("1. BREAST CANCER DATASET")
print("=" * 55)
print("Total Samples:", X.shape[0])
print("Total Input Features:", X.shape[1])
print("Target Classes:", list(cancer.target_names))
print("\nClass Distribution:")
print(pd.Series(y).map(
    {0: "Malignant", 1: "Benign"}
).value_counts().to_string())

print("\nFirst 5 Dataset Records:")
display(X.head())

# 2. Split data into training and testing sets
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.20, random_state=42, stratify=y
)

# 3. Normalize the input features
scaler = StandardScaler()
X_train_scaled = scaler.fit_transform(X_train)
X_test_scaled = scaler.transform(X_test)

print("\n" + "=" * 55)
print("2. ANN MODEL CONFIGURATION")
print("=" * 55)
print("Training Samples:", len(X_train))
print("Testing Samples:", len(X_test))
print("Input Neurons:", X.shape[1])
print("Hidden Layers: 16 and 8 neurons")
print("Output Classes: 2")
print("Learning Algorithm: Backpropagation")
print("Activation Function: ReLU (hidden), Logistic (output)")
print("Optimizer: Adam")

# 4. Build and train ANN using backpropagation
ann = MLPClassifier(
    hidden_layer_sizes=(16, 8),
    activation='relu',
    solver='adam',
    learning_rate_init=0.001,
    max_iter=500,
    random_state=42,
    early_stopping=True,
    validation_fraction=0.15,
    n_iter_no_change=25
)

ann.fit(X_train_scaled, y_train)

print("\n" + "=" * 55)
print("3. TRAINING RESULTS")
print("=" * 55)
print("Training Completed Successfully")
print("Iterations:", ann.n_iter_)
print("Final Training Loss:", round(ann.loss_, 6))

# 5. Plot training loss
plt.figure(figsize=(8, 4))
plt.plot(ann.loss_curve_, label="Training Loss")
plt.title("ANN Backpropagation - Training Loss")
plt.xlabel("Iteration")
plt.ylabel("Loss")
plt.legend()
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.show()

# 6. Test the trained network
y_pred = ann.predict(X_test_scaled)
accuracy = accuracy_score(y_test, y_pred)

print("\n" + "=" * 55)
print("4. MODEL PERFORMANCE")
print("=" * 55)
print("Testing Accuracy:", round(accuracy * 100, 2), "%")
print("\nClassification Report:")
print(classification_report(
    y_test, y_pred,
    target_names=cancer.target_names,
    zero_division=0
))

# 7. Confusion matrix
cm = confusion_matrix(y_test, y_pred)

print("5. CONFUSION MATRIX")
display(pd.DataFrame(
    cm,
    index=["Actual Malignant", "Actual Benign"],
    columns=["Predicted Malignant", "Predicted Benign"]
))

ConfusionMatrixDisplay(
    confusion_matrix=cm,
    display_labels=cancer.target_names
).plot(cmap="Blues", values_format="d")
plt.title("ANN - Confusion Matrix")
plt.tight_layout()
plt.show()

# 8. Show actual vs predicted results
results = pd.DataFrame({
    "Actual Class": cancer.target_names[y_test[:15]],
    "Predicted Class": cancer.target_names[y_pred[:15]],
    "Correct Prediction": y_test[:15] == y_pred[:15]
})

print("\n6. ACTUAL VS PREDICTED CLASSIFICATION")
display(results)

# 9. Compare training and testing accuracy
train_accuracy = accuracy_score(
    y_train, ann.predict(X_train_scaled)
)

accuracy_table = pd.DataFrame({
    "Dataset": ["Training", "Testing"],
    "Accuracy (%)": [
        round(train_accuracy * 100, 2),
        round(accuracy * 100, 2)
    ]
})

print("\n7. ACCURACY COMPARISON")
display(accuracy_table)

plt.figure(figsize=(6, 4))
plt.bar(
    accuracy_table["Dataset"],
    accuracy_table["Accuracy (%)"]
)
plt.ylim(0, 105)
plt.ylabel("Accuracy (%)")
plt.title("ANN Training vs Testing Accuracy")
plt.grid(axis="y", alpha=0.3)
plt.tight_layout()
plt.show()

# 10. Predict one new sample from the test dataset
sample = X_test.iloc[[0]]
sample_scaled = scaler.transform(sample)
sample_prediction = ann.predict(sample_scaled)[0]
sample_probabilities = ann.predict_proba(sample_scaled)[0]

print("\n" + "=" * 55)
print("8. NEW SAMPLE PREDICTION")
print("=" * 55)
print("Predicted Class:", cancer.target_names[sample_prediction])
print("Actual Class:", cancer.target_names[y_test[0]])
print("Predicted Probabilities:")
for i, class_name in enumerate(cancer.target_names):
    print(class_name, ":", round(sample_probabilities[i] * 100, 2), "%")

print("\nANN BACKPROPAGATION EXECUTION COMPLETED")
