# Import libraries
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from sklearn.model_selection import train_test_split
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import accuracy_score, classification_report, confusion_matrix

# Create dataset
data = {
    'RAM': [2, 3, 4, 4, 6, 6, 8, 8, 12, 12, 16, 16],
    'Battery': [2500, 3000, 3500, 4000, 3500, 4500, 4000, 5000, 4500, 5000, 5000, 6000],
    'Storage': [16, 32, 32, 64, 64, 128, 128, 128, 256, 256, 512, 512],
    'Camera': [8, 12, 13, 16, 20, 24, 32, 48, 48, 64, 64, 108],
    'Price_Range': [0, 0, 0, 1, 1, 1, 2, 2, 2, 3, 3, 3]
}

df = pd.DataFrame(data)

# Features and target
X = df.drop('Price_Range', axis=1)
y = df['Price_Range']

# Split dataset
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.25, random_state=42, stratify=y
)

# Create model
model = RandomForestClassifier(n_estimators=100, random_state=42)

# Train model
model.fit(X_train, y_train)

# Prediction
y_pred = model.predict(X_test)

# Accuracy
print("Accuracy:", accuracy_score(y_test, y_pred))
print("\nClassification Report:\n", classification_report(y_test, y_pred, zero_division=0))

# Predict new mobile price range
new_mobile = pd.DataFrame({
    'RAM': [8],
    'Battery': [5000],
    'Storage': [128],
    'Camera': [48]
})

prediction = model.predict(new_mobile)
print("Predicted Price Range:", prediction[0])

# Visualization
plt.bar(df['RAM'], df['Price_Range'])
plt.xlabel("RAM (GB)")
plt.ylabel("Price Range")
plt.title("Mobile Price Prediction")
plt.show()

# Feature importance
plt.bar(X.columns, model.feature_importances_)
plt.xlabel("Features")
plt.ylabel("Importance")
plt.title("Feature Importance")
plt.show()
